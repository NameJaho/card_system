CARD_HTTP_PORT=8080
CARD_ENV=production
CARD_PUBLIC_BASE_URL=https://card.example.com
CARD_CORS_ORIGINS=https://card.example.com
CARD_APP_VERSION=1.0.0
CARD_GIT_SHA=replace-with-release-commit
CARD_SECRET_KEY=please-change-this-to-a-long-random-value
CARD_ALLOW_DEV_RESET_LINK=false
CARD_SMTP_HOST=smtp.example.com
CARD_SMTP_PORT=587
CARD_SMTP_USER=mailer@example.com
CARD_SMTP_PASSWORD=please-change-smtp-password
CARD_SMTP_FROM=mailer@example.com
CARD_SMTP_STARTTLS=true

CARD_DEFAULT_ADMIN_USER=admin
CARD_DEFAULT_ADMIN_PASSWORD=please-change-admin-password
CARD_DEFAULT_ADMIN_EMAIL=admin@example.com

PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
MYSQL_ROOT_PASSWORD=please-change-root-password
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=card_system
MYSQL_USER=card_user
MYSQL_PASSWORD=please-change-card-user-password
MYSQL_DATA_DIR=./runtime/mysql
TZ=Asia/Shanghai
